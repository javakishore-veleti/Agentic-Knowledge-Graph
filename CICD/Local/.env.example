# Copy to .env. Local only -- never used for Azure or AWS (Key Vault / Secrets Manager own those).
AKG_ENV=local
COMPOSE_PROJECT_NAME=akg
AKG_NETWORK=akg-net

POSTGRES_USER=akg
POSTGRES_PASSWORD=akg-local-only
POSTGRES_DB=akg
POSTGRES_PORT=5432

REDPANDA_KAFKA_PORT=9092
REDPANDA_ADMIN_PORT=9644

# Azurite's documented development credentials. Public, fixed, and safe to commit:
# they only ever address the local emulator.
AZURITE_BLOB_PORT=10000
AZURITE_ACCOUNT=devstoreaccount1

REDIS_PORT=6379
OTEL_GRPC_PORT=9317
OTEL_HTTP_PORT=9318
GRAFANA_PORT=9030
AIRFLOW_PORT=8080
# The middleware triggers DAGs over Airflow's REST API and needs real credentials.
# Local only -- in Azure these come from Key Vault via the container environment.
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=akg-local-only

# ---------------------------------------------------------------------------
# Endpoint configuration (ADR-015)
#
# Endpoints in the catalog store the NAME of the variable that supplies each value,
# never the value. One endpoint row therefore works in every environment: local, Azure
# and AWS supply different values for the same names. Everything this platform reads is
# AKG_-prefixed, and the database rejects a config_env entry that is not.
#
# Check what resolves where the code is running:
#   GET /api/v1/app-endpoints/{id}/resolve      (reports names, never values)
# ---------------------------------------------------------------------------

# --- local filesystem ---
AKG_LOCAL_DATA_ROOT=/tmp/akg-data

# --- PubMed origin ---
AKG_PUBMED_BASELINE_URL=https://ftp.ncbi.nlm.nih.gov/pubmed/baseline/

# --- AWS S3 -------------------------------------------------------------
# Three system endpoints exist for S3 and you pick by which one you reference:
#   aws-s3-profile  a named profile in ~/.aws/credentials   (nothing below needed)
#   aws-s3-role     an attached instance/task/IRSA role      (nothing below needed)
#   aws-s3-keys     the two key variables below
AKG_AWS_REGION=us-east-1
AKG_AWS_S3_BUCKET=akg-raw
# AKG_AWS_ACCESS_KEY_ID=
# AKG_AWS_SECRET_ACCESS_KEY=

# --- Azure Blob ---------------------------------------------------------
#   azure-blob-cli  the token `az login` left here          (nothing below needed)
#   azure-blob-msi  managed identity inside Azure            (nothing below needed)
#   azure-blob-sp   the service principal variables below
AKG_AZURE_STORAGE_ACCOUNT=akgraw
AKG_AZURE_STORAGE_CONTAINER=raw
# AKG_AZURE_TENANT_ID=
# AKG_AZURE_CLIENT_ID=
# AKG_AZURE_CLIENT_SECRET=

# --- PostgreSQL: local, RDS, Azure --------------------------------------
AKG_PG_HOST=localhost
AKG_PG_PORT=5432
AKG_PG_DATABASE=akg
AKG_PG_USERNAME=akg
AKG_PG_PASSWORD=akg-local-only

# AKG_RDS_PG_HOST=
# AKG_RDS_PG_PORT=5432
# AKG_RDS_PG_DATABASE=akg
# AKG_RDS_PG_USERNAME=akg
# AKG_RDS_PG_PASSWORD=

# AKG_AZURE_PG_HOST=
# AKG_AZURE_PG_PORT=5432
# AKG_AZURE_PG_DATABASE=akg
# AKG_AZURE_PG_USERNAME=akg
# AKG_AZURE_PG_PASSWORD=

# The host directory the local filesystem endpoint writes into. Mounted into Airflow so a
# download is visible on this machine rather than inside a container.
# Defaults to $HOME/runtime_data/AKG/Local/FileSystem.
#AKG_LOCAL_FS_HOST_ROOT=
