# Copy to .env. Local only -- never used for Azure or AWS (Key Vault / Secrets Manager own those).
AKG_ENV=local
COMPOSE_PROJECT_NAME=akg
AKG_NETWORK=akg-net

POSTGRES_USER=akg
POSTGRES_PASSWORD=akg-local-only
POSTGRES_DB=akg
POSTGRES_PORT=5432

REDPANDA_KAFKA_PORT=9092
REDPANDA_ADMIN_PORT=9644

# Azurite's documented development credentials. Public, fixed, and safe to commit:
# they only ever address the local emulator.
AZURITE_BLOB_PORT=10000
AZURITE_ACCOUNT=devstoreaccount1

REDIS_PORT=6379
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
GRAFANA_PORT=3000
AIRFLOW_PORT=8080
